# Supabase — from Regina's project:
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Never expose this to the browser, never commit it.
# Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# The unguessable path to the guest list page.
# The list lives at /list/<this value>
# Generate one with:  openssl rand -hex 12
GUEST_LIST_SLUG=
